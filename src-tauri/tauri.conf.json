{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T4 Markdown Viewer",
  "version": "1.1.0",
  "identifier": "com.montevirgen.t4-markdown-viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Markdown Viewer",
        "width": 1100,
        "height": 860,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["themes/*"],
    "shortDescription": "Markdown Viewer",
    "longDescription": "A fast, themeable Markdown viewer.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdtext"],
        "name": "T4MarkdownViewer.Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop",
        "postInstallScript": "./linux/postinst.sh",
        "files": {
          "/usr/share/mime/packages/t4-markdown-viewer.xml": "./linux/t4-markdown-viewer.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "./linux/main.desktop",
        "postInstallScript": "./linux/postinst.sh",
        "files": {
          "/usr/share/mime/packages/t4-markdown-viewer.xml": "./linux/t4-markdown-viewer.xml"
        }
      }
    }
  }
}
